# Copy to .env and fill in your real values. .env is gitignored.
# The Garmin sync script reads these.

GARMIN_EMAIL=your.email@example.com
GARMIN_PASSWORD=your-garmin-password

# Optional. Defaults to "c_self".
# GARMIN_CLIENT_ID=c_self

# Optional. How many days back to pull on each run. Defaults to 14.
# GARMIN_LOOKBACK_DAYS=14

# Required for the "Ask FitOntology" assistant page. Get a key at
# https://console.anthropic.com/. Defaults to Claude Haiku for speed and
# cost; override with FITONTOLOGY_MODEL=claude-opus-4-7 for harder questions.
ANTHROPIC_API_KEY=
# FITONTOLOGY_MODEL=claude-haiku-4-5-20251001
