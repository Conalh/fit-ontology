# Copy to .env and fill in your real values. .env is gitignored, and the
# app loads it at startup (see fit_ontology.config.load_env). Everything
# here is optional for a bare local dev run; the sections below note what
# each group is for and what a production deploy should set.

# ─── Garmin sync (scripts/sync_garmin.py) ────────────────────────────
GARMIN_EMAIL=your.email@example.com
GARMIN_PASSWORD=your-garmin-password
# Optional. Defaults to "c_self".
# GARMIN_CLIENT_ID=c_self
# Optional. How many days back to pull on each run. Defaults to 14.
# GARMIN_LOOKBACK_DAYS=14

# ─── Ask FitOntology assistant ───────────────────────────────────────
# Required for the "Ask FitOntology" page. Get a key at
# https://console.anthropic.com/. Defaults to Claude Haiku for speed and
# cost; override with FITONTOLOGY_MODEL for harder questions.
ANTHROPIC_API_KEY=
# FITONTOLOGY_MODEL=claude-haiku-4-5-20251001
# Optional comma-separated allowlist of models the /api/ask endpoint will
# accept from the client. The default model above is always allowed.
# FIT_ONTOLOGY_ALLOWED_ASK_MODELS=claude-haiku-4-5-20251001,claude-opus-4-8

# ─── Auth & sessions ─────────────────────────────────────────────────
# Secret used to sign the session cookie. REQUIRED in any non-dev deploy:
# without it the app generates a random per-process secret and every
# restart invalidates all sessions. Generate with e.g.
#   openssl rand -base64 48
# FIT_ONTOLOGY_SESSION_SECRET=
# One-time bootstrap password for the default trainer. Applied only if the
# trainer row has no password yet (so it isn't re-applied on every boot).
# To rotate: clear it, set a new value, restart.
# FIT_ONTOLOGY_DEFAULT_TRAINER_PASSWORD=
# Send the session cookie only over HTTPS (and emit HSTS). Leave unset for
# http://localhost dev; set to 1 in any HTTPS deploy.
# FIT_ONTOLOGY_SESSION_SECURE=1
# Return 401 on unauthenticated requests to scoped routes. Production
# multi-tenant posture; leave unset for a single-trainer / perimeter-auth
# (e.g. Cloudflare Access) deploy.
# FIT_ONTOLOGY_REQUIRE_AUTH=1
# Serve read-only demo content to unauthenticated visitors. Overrides
# REQUIRE_AUTH for the public demo. Mutating routes 403 for the demo trainer.
# FIT_ONTOLOGY_DEMO_MODE=1

# ─── Storage ─────────────────────────────────────────────────────────
# Path to the DuckDB file. Defaults to <repo>/data/fit_ontology.duckdb.
# The Docker image / Fly deploy point this at the persistent volume.
# FIT_ONTOLOGY_DB=/data/fit.duckdb
# Max accepted wearable-upload size in bytes. Defaults to 25 MiB.
# FIT_ONTOLOGY_MAX_UPLOAD_BYTES=26214400

# ─── Error monitoring (optional; pip install -e .[monitoring]) ────────
# When set, initialises Sentry. Unset = no telemetry (the dev default).
# FIT_ONTOLOGY_SENTRY_DSN=
# FIT_ONTOLOGY_SENTRY_ENV=production
# FIT_ONTOLOGY_RELEASE=fit-ontology@0.5.1
